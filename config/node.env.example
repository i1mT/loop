# Node 自托管（PostgreSQL + S3）配置模板。
# 复制到仓库外或部署机的受保护位置（例如 /srv/loop/.env），执行 chmod 600；不要提交真实值。
# 三个令牌与主密钥分别使用 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" 生成，不要重复使用同一值。

# Postgres 连接串。自建数据库示例：
# postgres://loop:密码@postgres:5432/loop
DATABASE_URL=

# 对外可访问的网关根地址（HTTPS）。后台通知里的链接用它拼接，必须是浏览器能打开的地址。
LOOP_PUBLIC_URL=https://loop.example.com

# 脚本与本地转发用的管理员令牌（Bearer），不能用来登录页面。
LOOP_ADMIN_TOKEN=
# 仅旧机器兼容需要的全局守护进程令牌；新机器用网页连接码换取独立令牌。
LOOP_DAEMON_TOKEN=
# better-auth 的会话签名密钥。
BETTER_AUTH_SECRET=
# 飞书凭证加密主密钥（32 字节 base64）。丢失后已保存的飞书凭证无法解密，需要单独备份。
FEISHU_ENCRYPTION_KEY=
# 可选：小问题规模判定。留空则所有反馈直接建任务。
TYPESAFE_API_KEY=

# 本机转发模式才会用到；Node 直连部署保持 {}。
LOOP_LOCAL={}

# ---- 对象存储（S3 API）----
# 桶名。需要在启动前自行创建（AWS 控制台、mc mb 或 s3cmd 等）。
S3_BUCKET=loop-files
# 可选：桶内路径前缀。多个部署共用一个桶、或桶根已有其他内容时用它隔离。
# 留空表示直接放在桶根。写成 loop / loop/ / /loop/ 都等价于 loop/。
S3_PREFIX=
# AWS 区域；自建存储填任意固定值（例如 us-east-1）。
S3_REGION=ap-southeast-1
# 自建或兼容端点，例如 MinIO 的 http://minio:9000、Cloudflare R2 的 https://<account>.r2.cloudflarestorage.com。
# 使用 AWS S3 时留空。
S3_ENDPOINT=
# 访问密钥。留空则使用 SDK 默认凭证链（EC2 实例角色、ECS 任务角色等），此时不要额外设置本机凭据文件。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 等自建端点通常需要 path-style；AWS S3 与 R2 使用 virtual-hosted。留空时：配置了 S3_ENDPOINT 则为 true。
S3_FORCE_PATH_STYLE=

# 监听地址与端口（容器内默认 0.0.0.0:3000）。
HOST=0.0.0.0
PORT=3000
# 后台集成任务（反馈恢复、技术方案推进、飞书作业）的轮询间隔，毫秒。与 Workers 的每分钟 trigger 对齐。
LOOP_INTEGRATION_INTERVAL_MS=60000
