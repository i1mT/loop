{
  "name": "@loop/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --config sdk/vite.config.ts && vite build",
    "build:sdk": "vite build --config sdk/vite.config.ts",
    "typecheck:sdk": "tsc -p sdk/tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test lib/*.test.ts lib/feishu/tests/*.test.ts lib/task-plan/*.test.ts",
    "test:db": "node --env-file=.env.local --experimental-strip-types --no-warnings --test --test-concurrency=1 lib/*.integration.test.ts lib/feishu/tests/*.integration.test.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.17",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@loop/core": "workspace:*",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tslib": "^2.8.1",
    "vinext": "1.2.1"
  },
  "type": "module"
}
